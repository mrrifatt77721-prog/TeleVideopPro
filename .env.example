# Telegram Bot Configuration Template
# IMPORTANT: Rename this file to .env and insert your real token
# NEVER commit your real .env file with actual bot token to public GitHub!

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz_example
WEBAPP_URL=https://YOUR_USERNAME.github.io/${appName}/
PORT=5000